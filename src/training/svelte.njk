---
layout: "base"
title: Svelte training
description: "We offer workshops to enable teams to succeed with Svelte & SvelteKit – covering a wide range from basics to advanced topics, onsite or remote."
og:
  image: "/assets/images/services/svelte-training-og-image.jpg"
eleventyImport:
  collections: ["workshops"]
---

{% from "color-hero.njk" import colorHero %}
{% from "workshop-card.njk" import workshopCard %}
{% from "cta-banner.njk" import ctaBanner %}
{% from "quote.njk" import quote %}
{% from "logo-list.njk" import logoList %}
{% from "contact-form-LP.njk" import contactFormLP %}
{% from "tech-cards.njk" import techCards %}
{% from "workshop-instructors.njk" import workshopInstructors %}
{% from "service-cta.njk" import serviceCta %}
{% from "image-aspect-ratio.njk" import imageAspectRatio %}


{% set heroEyebrow %}
  <a class="workshops-page-hero__eyebrow-link" href="/training/">
    <span class="workshops-page-hero__eyebrow-arrow">{% include 'svg/arrow.njk' %}</span>
    <span class="workshops-page-hero__eyebrow-text">Training and workshops</span>
  </a>
{% endset %}

{%
  set heroContent = {
  "eyebrow": heroEyebrow,
  "title": "Svelte training",
  "text": "We teach teams and individuals how to adopt and succeed with Svelte. All of our workshops are hands-on, since the best way to learn is by doing. The workshops cover everything from language basics to advanced testing, Svelte 5 migrations, progressive enhancement, and authentication. We're also happy to prepare custom workshops, as well as on-site ones. <a href='/contact/?service=Training'>Get in touch with us</a> with us to talk about what curriculum fits best.",
  "image": "/assets/images/hero/table-soccer.jpg",
  "alt": "Close-up photo of table soccer figures",
  "loading": "eager",
  "class": "workshops-page-hero",
  "toc": [
    ["Our workshops", "#workshops"],
    ["Custom workshops", "#custom-workshops"],
    ["Our instructors", "#instructor"],
    ["Our attendees say", "#attendees-say"],
    ["More training material", "#more-training-material"]
  ],
  "hideFirstTocItemOnDesktop": false,
  "containerType": "lp"
  }
%}
{{ colorHero('purple', heroContent) }}

{%
  set svelteWorkshops = [
  collections.workshops | findByCollectionSlug("svelte-and-sveltekit"),
  collections.workshops | findByCollectionSlug("svelte-5-runes"),
  collections.workshops | findByCollectionSlug("testing-svelte-sveltekit-applications"),
  collections.workshops | findByCollectionSlug("progressive-enhancement-with-sveltekit"),
  collections.workshops | findByCollectionSlug("authentication-for-svelte-sveltekit"),
  collections.workshops | findByCollectionSlug("practical-typescript"),
  collections.workshops | findByCollectionSlug("svelte-without-svelte")
  ]
%}

<div class="workshops-page">
  <section class="container container--xl my-5" id="workshops">
    <ul class="workshops-page__list">
      {% for workshop in svelteWorkshops %}
        <li>{{ workshopCard(workshop) }}</li>
      {% endfor %}
    </ul>
  </section>

  {%
    set teamCta = {
    "id": "custom-workshops",
    "title": "Can't find the right workshop for your team?",
    "text": "We are happy to tailor the curriculum to your needs. We can combine multiple workshops, pick and choose modules, as well as develop new content if desired.",
    "linkUrl": "/contact/?service=Training",
    "linkText": "Get in touch"
    }
  %}
  {{ ctaBanner('purple', 'medium', teamCta) }}

  {%
    set logoCompanies = [
    'Rail Europe',
    'Keyrock',
    'Strabag',
    'Thales',
    'Google',
    'faculty',
    'Canonical',
    'Hyland',
    'Lego',
    'Rillet',
    'CERN',
    'Redis',
    'HashiCorp'
    ]
  %}
  {{ logoList(logoCompanies, "We are trusted by startups and Fortune Global 500 companies", "h4", "h5") }}

  {%
    set instructors = [
    {
    "name": "Paolo Ricciuti",
    "bio": "Our team is led by Paolo Ricciuti, Svelte maintainer and co-author of SvelteLab. Mainmatter is also the driving force behind the <a href=\"https://svelte-custom-renderers.com\" target=\"_blank\">Svelte Custom Renderers initiative</a>, an active contributor to a number of open source projects and co-organizer of <a href=\"https://sveltesummit.com\" target=\"_blank\">Svelte Summit</a>.",
    "image": "/assets/images/authors/paoloricciuti.jpg"
    }
    ]
  %}

  {{ workshopInstructors(instructors) }}

  <section class="container container--lg my-10" id="attendees-say">
    <h2 class="mb-4">Our attendees say</h2>
    <div class="training-quotes">
      {%
        set quoteContent = {
        "text": "I enjoyed the workshop, Paolo managed to balance well its content between theory and practice.",
        "source": "Onsite attendee",
        "styling": "redesigned"
        }
      %}
      {{ quote(quoteContent) }}

      {%
        set quoteContent = {
        "text": "The individual exercises build on each other very well. Direct practice makes it easier to understand the topics. I have rarely taken part in such a good practical workshop!",
        "source": "Remote attendee",
        "styling": "redesigned"
        }
      %}
      {{ quote(quoteContent) }}

      {%
        set quoteContent = {
        "text": "I usually avoid workshops. The pace of more than 3 people is hard to sync: I always feel rushed in some bits, slowed down in others. You fixed that with your code-centric approach: I was able to fully use the time and the knowledge of the trainer!",
        "source": "Onsite attendee",
        "styling": "redesigned"
        }
      %}
      {{ quote(quoteContent) }}

      {%
        set quoteContent = {
        "text": "SvelteKit can be fun!",
        "source": "Onsite attendee",
        "styling": "redesigned"
        }
      %}
      {{ quote(quoteContent) }}
    </div>
  </section>

  {%
    set trainingMaterials = [
    {
      "title": "Why I choose Svelte",
      "link": "/blog/2026/02/24/why-choose-svelte/",
      "logo": "svelte"
    },
    {
      "title": "How to build Web Components with Svelte",
      "link": "/blog/2025/06/25/web-components-with-svelte/",
      "logo": "svelte"
    },
    {
      "title": "Truly Native Apps with Svelte?",
      "link": "/blog/2025/05/22/native-apps-with-svelte/",
      "logo": "svelte"
    }
    ]
  %}

  {{ techCards('more-training-material', 'Explore our other training materials', '', trainingMaterials) }}

  {{ serviceCta(["svelte"]) }}

  <section>
    {%
      set imageData = {
      "imgPath": "/assets/images/photos/notebook-list.jpg",
      "alt": "Svelte workshop materials",
      "sizes": "100vw",
      "loading": "lazy",
      "sizesArray": [760, 1440, 1920]
      }
    %}
    {{ imageAspectRatio(imageData, "4/1", "35/19") }}
  </section>
</div>
