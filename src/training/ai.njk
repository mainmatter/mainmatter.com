---
layout: "base"
title: AI Training
description: "We offer workshops that teach teams how to build AI-enabled products and adopt AI for the software engineering process."
og:
  image: "/assets/images/services/ai-training-og-image.jpg"
eleventyImport:
  collections: ["workshops"]
---

{% from "color-hero.njk" import colorHero %}
{% from "workshop-card.njk" import workshopCard %}
{% from "cta-banner.njk" import ctaBanner %}
{% from "quote.njk" import quote %}
{% from "logo-list.njk" import logoList %}
{% from "workshop-instructors.njk" import workshopInstructors %}
{% from "image-aspect-ratio.njk" import imageAspectRatio %}


{% set heroEyebrow %}
  <a class="workshops-page-hero__eyebrow-link" href="/training/">
    <span class="workshops-page-hero__eyebrow-arrow">{% include 'svg/arrow.njk' %}</span>
    <span class="workshops-page-hero__eyebrow-text">Developer Training</span>
  </a>
{% endset %}

{%
  set heroContent = {
  "eyebrow": heroEyebrow,
  "title": "AI Training",
  "text": "We teach teams like yours how to adopt AI and keep up with a fast-moving field. We look past the hype to where the real value is, so your team can leverage AI efficiently, responsibly, and sustainably.",
  "image": "/assets/images/hero/ai-workshops.jpg",
  "alt": "AI workshop session",
  "loading": "eager",
  "class": "workshops-page-hero",
  "toc": [
    ["Workshops", "#workshops"],
    ["Instructor", "#instructor"],
    ["Attendees Say", "#attendees-say"]
  ],
  "hideFirstTocItemOnDesktop": false,
  "containerType": "lp"
  }
%}
{{ colorHero('purple', heroContent) }}

{%
  set aiWorkshops = [
  collections.workshops | findByCollectionSlug("agentic-engineering-with-svelte"),
  collections.workshops | findByCollectionSlug("building-mcp-servers")
  ]
%}

<div class="workshops-page">
  <section class="container container--xl my-10" id="workshops">
    <div class="workshops-page__intro">
      <div class="workshops-page__intro-text">
        <h2 class="mb-2">AI workshops</h2>
        <p>
          We teach product and engineering teams how to put AI to work with topics ranging from
          building AI-enabled products to adopting AI for the software engineering process, with new
          workshops added as the field evolves. All our workshops are hands-on, because the best way
          to learn is by doing.
        </p>
        <p>
          We're also happy to prepare custom workshops – <a href="/contact/?service=Training"
            >get in touch with us</a
          > to talk about what curriculum fits your team best!
        </p>
      </div>
    </div>

    <ul class="workshops-page__list">
      {% for workshop in aiWorkshops %}
        {% if workshop %}
          <li>{{ workshopCard(workshop) }}</li>
        {% endif %}
      {% endfor %}
    </ul>
  </section>

  {%
    set teamCta = {
    "title": "Can't find the right workshop for your team?",
    "text": "We are happy to tailor the curriculum to your needs. We can combine multiple workshops, pick and choose modules, as well as develop new content if desired.",
    "linkUrl": "/contact/?service=Training",
    "linkText": "Get in touch"
    }
  %}
  {{ ctaBanner('purple', 'medium', teamCta) }}

  {%
    set logoCompanies = [
    'Redis',
    'Keyrock',
    'CERN',
    'Thales',
    'faculty',
    'Canonical',
    'Lego',
    'Rail Europe'
    ]
  %}
  {{ logoList(logoCompanies, 'We have trained developers at', 'h2', 'h3') }}

  {%
    set instructors = [
    {
    "name": "Paolo Ricciuti",
    "bio": "Paolo Ricciuti is a Svelte maintainer and one of the creators of <a href=\"https://sveltelab.dev\">sveltelab.dev</a>, a REPL for SvelteKit.",
    "image": "/assets/images/authors/paoloricciuti.jpg"
    }
    ]
  %}

  {{ workshopInstructors(instructors) }}

  <section class="container container--lg my-10" id="attendees-say">
    <h2 class="mb-4">Our attendees say</h2>
    <div class="training-quotes">
      {%
        set quoteContent = {
        "text": "The workshop helped us understand how to turn AI ideas into concrete product experiments.",
        "source": "Remote attendee",
        "styling": "redesigned"
        }
      %}
      {{ quote(quoteContent) }}

      {%
        set quoteContent = {
        "text": "The hands-on exercises made the AI concepts much easier to evaluate and apply to our own work.",
        "source": "Onsite attendee",
        "styling": "redesigned"
        }
      %}
      {{ quote(quoteContent) }}
    </div>
  </section>

  <section>
    {%
      set imageData = {
      "imgPath": "/assets/images/photos/ai-workshops-footer.jpg",
      "alt": "AI workshop",
      "sizes": "100vw",
      "loading": "lazy",
      "sizesArray": [760, 1440, 1920]
      }
    %}
    {{ imageAspectRatio(imageData, "4/1", "35/19") }}
  </section>
</div>
