---
layout: "base"
title: Training and workshops
description: "Mainmatter offers developer training in Rust, Svelte, Ember, and AI. Topics include language basics, C-to-Rust, testing, and more, for teams and individuals."
eleventyNavigation:
  key: training
  order: 7
  title: Training and workshops
og:
  image: "/assets/images/services/training-og-image.jpg"
---

{% from "color-hero.njk" import colorHero %}
{% from "logo-list.njk" import logoList %}
{% from "quote.njk" import quote %}
{% from "tech-cards.njk" import techCards %}
{% from "cta-banner.njk" import ctaBanner %}
{% from "image-aspect-ratio.njk" import imageAspectRatio %}

{%
  set rustTraining = {
  "logo": "rust",
  "link": "/training/rust/",
  "linkText": "Rust training"
  }
%}
{%
  set svelteTraining = {
  "logo": "svelte",
  "link": "/training/svelte/",
  "linkText": "Svelte training"
  }
%}
{%
  set emberTraining = {
  "logo": "ember",
  "link": "/training/ember/",
  "linkText": "Ember training"
  }
%}
{%
  set aiTraining = {
  "logo": "ai",
  "link": "/training/ai/",
  "linkText": "AI training"
  }
%}

{%
  set hero = {
  "title": "Training and workshops",
  "text": "We teach teams and individuals how to adopt and succeed with Rust, Svelte, Ember, and AI. Our workshops are hands-on and can be run remotely or on-site. We're also happy to prepare custom workshops.",
  "image": "/assets/images/hero/workshops-hero.jpg",
  "alt": "Wrenches laying on a table",
  "loading": "eager",
  "class": "training-landing-hero",
  "technologies": [rustTraining, svelteTraining, emberTraining, aiTraining]
  }
%}
{{ colorHero('purple', hero) }}

{%
  set logoCompanies = [
  'Redis',
  'Keyrock',
  'Generali',
  'CERN',
  'Thales',
  'Süddeutsche Zeitung',
  'faculty',
  'CERN',
  'Canonical',
  'NTT Data',
  'Truelayer',
  'Lego',
  'BMW Car IT',
  'Change Healthcare',
  'Rail Europe'
  ]
%}
<div class="workshops-landing__logos">
  {{ logoList(logoCompanies, 'We have trained developers at', 'h2', 'h2') }}
</div>

<section class="workshops-landing__quotes pt-7" id="our-attendees-say">
  <div class="container container--lg">
    <h2 class="mb-4">Our attendees say</h2>
    <div class="training-quotes">
      {%
        set quoteContent = {
        "text": "The individual exercises build on each other very well. Direct practice makes it easier to understand the topics. I have rarely taken part in such a good practical workshop!",
        "source": "Remote attendee",
        "styling": "redesigned"
        }
      %}
      {{ quote(quoteContent) }}

      {%
        set quoteContent = {
        "text": "It's not like the typical workshop where the presenter just goes through some topics which could be researched individually. I really get the feeling of learning something here.",
        "source": "Onsite attendee",
        "styling": "redesigned"
        }
      %}
      {{ quote(quoteContent) }}
    </div>
  </div>
</section>

<section class="workshops-landing__photos mt-10" aria-label="Workshop photos">
  <div class="container container--lg">
    <div class="photo-grid">
      <img
        class="photo-grid__img-1"
        src="/assets/images/photos/mainmatter-team-brainstorm.jpg"
        alt="Workshop attendees brainstorming"
      />
      <img
        class="photo-grid__img-2"
        src="/assets/images/photos/workshop.jpg"
        alt="Workshop attendees"
      />
      <img
        class="photo-grid__img-3"
        src="/assets/images/rust-telemetry-workshop/rust-telemetry-workshop-eurorust-2023.jpg"
        alt="Workshop talk"
      />
      <img
        class="photo-grid__img-4"
        src="/assets/images/photos/events.jpg"
        alt="Speaker on stage"
      />
      <img
        class="photo-grid__img-5"
        src="/assets/images/photos/luca.jpg"
        alt="Luca Palmieri giving a talk"
      />
    </div>
  </div>
</section>

{%
  set workshopCards = [
  {
  "logo": "rust",
  "title": "Rust training",
  "link": "/training/rust/"
  },
  {
  "logo": "svelte",
  "title": "Svelte training",
  "link": "/training/svelte/"
  },
  {
  "logo": "ember",
  "title": "Ember training",
  "link": "/training/ember/"
  },
  {
  "logo": "ai",
  "title": "AI training",
  "link": "/training/ai/"
  }
  ]
%}
<div class="workshops-landing__catalog">
  {{ techCards('workshops-landing-catalog', 'Explore our training offering', null, workshopCards) }}
</div>

<section>
  {%
    set imageData = {
    "imgPath": "/assets/images/photos/colorful-pens.jpg",
    "alt": "Colorful pens",
    "sizes": "100vw",
    "loading": "lazy",
    "sizesArray": [760, 1440, 1920]
    }
  %}
  {{ imageAspectRatio(imageData, "4/1", "35/19") }}
</section>
