{#
List of case studies as cards

Configuration Options:
list: An array where each item is the slug for the case study.
layout: Optional "split" layout for two cases, with the featured case on the right.
#}
{% from 'featured-case-study.njk' import featuredCaseStudy %}
{% from 'case-card.njk' import caseCard %}
{%- macro featuredCaseStudies(caseStudies, heading, layout) -%}
  <section class="featured-case-studies{% if layout == 'split' %} featured-case-studies--split{% endif %}">
    <div class="container container--xl">
      {%- if heading -%}
        <h2 class="featured-case-studies__heading h5">{{ heading }}</h2>
      {%- endif -%}
      <ul class="featured-case-studies__list">
        {% if layout == 'split' %}
          {{ caseCard(caseStudies[1]) }}
          {{ featuredCaseStudy(caseStudies[0], 'purple') }}
        {% else %}
          {%- for caseStudyHandle in caseStudies -%}
            {% if loop.index === 1 %}
              {{ featuredCaseStudy(caseStudyHandle, 'purple') }}
            {% else %}
              {{ caseCard(caseStudyHandle) }}
            {% endif %}
          {% endfor %}
        {% endif %}
      </ul>
    </div>
  </section>
{%- endmacro -%}
