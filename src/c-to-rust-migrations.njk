    {"title": "Build the verification system the migration rests on, covering differential testing, fuzzing, sanitizers, and shadow deployment."},
    {"title": "Execute the migration using coding agents where possible to move faster without giving up quality."},
    {"title": "Mentor your team throughout, so they can finish the migration and evolve the codebase after we leave."}
  ]
%}
