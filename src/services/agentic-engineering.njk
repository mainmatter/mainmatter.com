<section class="mt-10">
  {%
    set imageData = {
      "imgPath": "/assets/images/photos/agentic-engineering-footer.jpg",
      "alt": "Agentic engineering workspace",
      "sizes": "100vw",
      "loading": "lazy",
      "sizesArray": [760, 1440, 1920]
    }
  %}
  {{ imageAspectRatio(imageData, "32/8", "35/19") }}
</section>
