{% from "btn-secondary.njk" import btnSecondary %}
{% from "contact-form-LP.njk" import contactFormLP %}
{% from "quote.njk" import quote %}

{%
  set content = {
    "title": "Turn AI into lasting productivity gains",
    "eyebrow": "Agentic engineering consulting",
    "text": "AI delivers real productivity gains for engineering teams, but capturing them takes more than getting Claude license for everyone. Agents produce valuable, reliable code only when they're steered with the right context and guardrails. And generating more code quickly shifts the bottleneck downstream, to validation and release: code that never ships has no value, and shipping broken code has negative value even. We guide engineering teams through that complexity so they adopt AI efficiently, responsibly, and sustainably for lasting productivity gains.",
    "image": "/assets/images/hero/agentic-engineering.jpg",
    "alt": "Desk setup for agentic engineering work",
    "loading": "eager"
  }
%}
{{ colorHero('purple', content) }}

<section class="container container--lg my-10">
  <div class="workshops-page__intro">
    <div class="workshops-page__intro-text">
      <p>
        Mainmatter has guided engineering teams for years, not just to adopt new technologies, but
        to improve the way they build: tightening their processes, practices, and infrastructure so
        that shipping is fast, safe, and repeatable. Those are the hallmarks of a strong engineering
        culture, and they matter more than ever as teams adopt AI.
      </p>
    </div>
  </div>
</section>

{%
  set list_1 = {
    "title": "Assess the status quo",
    "text": "We map your team's setup and maturity, covering composition and experience, tooling and infrastructure, development practices, testing and release processes. That surfaces the blockers holding back your software delivery lifecycle."
  }
%}
{%
  set list_2 = {
    "title": "Define what success looks like",
    "text": "Together we set the target and put tracking in place for metrics like velocity, lead time for changes, and change failure rate, so progress stays visible and grounded in real outcomes."
  }
%}
{%
  set list_3 = {
    "title": "Clear the path",
    "text": "We close the gaps in your delivery pipeline: testing, automation, infrastructure, observability. A pipeline that strains under today's volume will only buckle when AI accelerates code production."
  }
%}
{%
  set list_4 = {
    "title": "Roll out tools and practices",
    "text": "With the foundation in place, we roll out tools incrementally, working alongside your engineers to support and mentor them as they go."
  }
%}
{% set elements = [list_1, list_2, list_3, list_4] %}
<div id="services">
  {{ strategyList('agentic-engineering', 'We’ll work with you to:', elements) }}
</div>

{%
  set trainingContent = {
    "title": "AI and agentic engineering training",
    "text": "We teach teams like yours how to adopt AI and keep up with a fast-moving field.",
